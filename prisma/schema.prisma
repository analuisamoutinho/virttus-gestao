// Virttus — schema multi-tenant. Isolamento LGPD: toda tabela de negócio
// carrega organizationId e é sempre filtrada por ele.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── TENANT ───────────────────────────
enum Plan {
  STARTER
  PRO
  TIME
}

enum BillingStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

model Organization {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  plan          Plan          @default(STARTER)
  billingStatus BillingStatus @default(TRIALING)
  onboardedAt   DateTime?

  // Stripe (Fase 4)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?

  users            User[]
  teamMembers      TeamMember[]
  oneOnOnes        OneOnOne[]
  feedbacks        Feedback[]
  goals            Goal[]
  pdis             PDI[]
  virtueScores     VirtueScore[]
  scripts          ConversationScript[]
  auditLogs        AuditLog[]
  invites          Invite[]
  trainings        Training[]
  notes            Note[]
  calls            Call[]
  practices        FeedbackPractice[]
  openings         JobOpening[]
  candidates       Candidate[]
  managerFeedbacks ManagerFeedback[]
  resources        DevResource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

// ─────────────────────────── AUTH / USERS ───────────────────────────
enum Role {
  ADMIN // dono da org, billing
  LEADER // líder que gere liderados
  HR // RH: painel agregado, sem editar 1:1 alheio
  MEMBER // liderado-somente-leitura do próprio perfil
}

model User {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name          String?
  email         String
  emailVerified DateTime?
  image         String?
  role          Role      @default(LEADER)

  // Auth.js
  accounts Account[]
  sessions Session[]

  // relações de negócio
  ledMembers        TeamMember[]       @relation("LeaderToMembers")
  memberProfile     TeamMember?        @relation("MemberUser")
  authoredFeedback  Feedback[]         @relation("FeedbackAuthor")
  auditLogs         AuditLog[]
  createdTrainings  Training[]         @relation("TrainingCreatedBy")
  authoredNotes     Note[]             @relation("NoteAuthor")
  createdCalls      Call[]             @relation("CallCreatedBy")
  practices         FeedbackPractice[]
  createdOpenings   JobOpening[]       @relation("OpeningCreatedBy")
  createdCandidates Candidate[]        @relation("CandidateCreatedBy")
  managerFeedbacks  ManagerFeedback[]  @relation("ManagerFeedbackManager")
  createdResources  DevResource[]      @relation("ResourceCreatedBy")

  // Link público (sem login) do formulário anônimo em que os liderados avaliam
  // este gestor. Rotacionar o token invalida o link anterior.
  anonFeedbackToken String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, email])
  @@index([organizationId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Invite {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           Role         @default(LEADER)
  token          String       @unique @default(cuid())
  acceptedAt     DateTime?
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  @@unique([organizationId, email])
  @@index([organizationId])
}

// ─────────────────────────── LIDERADOS ───────────────────────────
model TeamMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  leaderId String
  leader   User   @relation("LeaderToMembers", fields: [leaderId], references: [id])

  // liderado pode ter login próprio (role MEMBER) ou existir apenas como registro
  userId String? @unique
  user   User?   @relation("MemberUser", fields: [userId], references: [id])

  name      String
  email     String?
  role      String? // cargo
  active    Boolean   @default(true)
  startedAt DateTime?

  profile      PersonalProfile?
  oneOnOnes    OneOnOne[]
  feedbacks    Feedback[]
  goals        Goal[]
  pdis         PDI[]
  virtueScores VirtueScore[]
  scripts      ConversationScript[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([leaderId])
}

model PersonalProfile {
  id           String     @id @default(cuid())
  teamMemberId String     @unique
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  feedbackPrefs      String? @db.Text
  motivators         String? @db.Text
  communicationStyle String? @db.Text
  strengths          String? @db.Text
  watchouts          String? @db.Text
  aspirations        String? @db.Text

  updatedAt DateTime @updatedAt
}

// ─────────────────────────── VIRTUDES ───────────────────────────
// 9 virtudes: 2 de liderança (Havard) + 4 cardeais + 3 teologais.
enum Virtue {
  MAGNANIMIDADE
  HUMILDADE
  PRUDENCIA
  JUSTICA
  CORAGEM
  AUTOCONTROLE
  FE
  ESPERANCA
  CARIDADE
}

enum VirtueGroup {
  LIDERANCA
  CARDEAL
  TEOLOGAL
}

model VirtueScore {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teamMemberId   String
  teamMember     TeamMember   @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  virtue     Virtue
  score      Float // 0–10 (série histórica → radar + evolução)
  source     String? // "1:1", "assessment", "manual"
  recordedAt DateTime @default(now())

  @@index([organizationId])
  @@index([teamMemberId, virtue])
}

// ─────────────────────────── 1:1 ───────────────────────────
enum OneOnOneStatus {
  SCHEDULED
  DONE
  CANCELED
}

model OneOnOne {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teamMemberId   String
  teamMember     TeamMember   @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  scheduledAt DateTime
  status      OneOnOneStatus @default(SCHEDULED)
  agenda      String?        @db.Text
  notes       String?        @db.Text
  focusVirtue Virtue?
  mood        Int? // 1–5
  actionItems ActionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([teamMemberId, scheduledAt])
}

model ActionItem {
  id         String    @id @default(cuid())
  oneOnOneId String
  oneOnOne   OneOnOne  @relation(fields: [oneOnOneId], references: [id], onDelete: Cascade)
  text       String
  done       Boolean   @default(false)
  dueDate    DateTime?

  @@index([oneOnOneId])
}

// ─────────────────────────── FEEDBACK (SBI) ───────────────────────────
enum FeedbackType {
  RECOGNITION
  CONSTRUCTIVE
}

model Feedback {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teamMemberId   String
  teamMember     TeamMember   @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  authorId       String
  author         User         @relation("FeedbackAuthor", fields: [authorId], references: [id])

  type      FeedbackType
  situation String       @db.Text
  behavior  String       @db.Text
  impact    String       @db.Text
  virtue    Virtue?

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([teamMemberId, createdAt])
}

// ─────────────────────────── METAS / OKR ───────────────────────────
model Goal {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teamMemberId   String
  teamMember     TeamMember   @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  objective  String
  quarter    String // ex "2026-Q3"
  progress   Float       @default(0) // auto-calculado a partir dos KRs
  keyResults KeyResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([teamMemberId])
}

model KeyResult {
  id      String  @id @default(cuid())
  goalId  String
  goal    Goal    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title   String
  target  Float
  current Float   @default(0)
  unit    String? // %, R$, un.

  @@index([goalId])
}

// ─────────────────────────── PDI ───────────────────────────
model PDI {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teamMemberId   String
  teamMember     TeamMember   @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  quarter     String // "2026-Q3" — 1 competência foco por trimestre
  focusVirtue Virtue
  competency  String
  actions     PDIAction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamMemberId, quarter])
  @@index([organizationId])
}

model PDIAction {
  id       String    @id @default(cuid())
  pdiId    String
  pdi      PDI       @relation(fields: [pdiId], references: [id], onDelete: Cascade)
  text     String
  dueDate  DateTime?
  done     Boolean   @default(false)
  evidence String?   @db.Text

  @@index([pdiId])
}

// ─────────────────────────── CONVERSA (Pro) ───────────────────────────
enum ConversationContextType {
  FEEDBACK_CONSTRUTIVO
  RECONHECIMENTO
  CONFLITO
  DESENVOLVIMENTO
  BAIXA_PERFORMANCE
}

model ConversationScript {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teamMemberId   String
  teamMember     TeamMember   @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  type        ConversationContextType
  situation   String                  @db.Text
  focusVirtue Virtue?
  opening     String?                 @db.Text
  questions   Json? // perguntas socráticas
  closing     String?                 @db.Text
  engine      String                  @default("rules") // "rules" agora, "llm" depois

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([teamMemberId])
}

// ─────────────────────────── TREINAMENTOS ───────────────────────────
// Cronograma do setor: visível apenas para quem está logado na organização
// (hoje, só a liderança) — mesmo isolamento por organizationId do resto do app.
enum TrainingStatus {
  PLANNED
  DONE
  CANCELED
}

model Training {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String?
  createdBy      User?        @relation("TrainingCreatedBy", fields: [createdById], references: [id])

  title       String
  description String?        @db.Text
  module      String? // ex.: "Mês 1 — Engenharia de Prompts e IA aplicada"
  scheduledAt DateTime
  status      TrainingStatus @default(PLANNED)
  focusVirtue Virtue?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, scheduledAt])
}

// ─────────────────────────── BIBLIOTECA DE LIDERANÇA ───────────────────────────
// Base de conhecimento, manuais e formulários da liderança — privado à
// organização (hoje, só quem está logado, isto é, a própria liderança).
enum NoteCategory {
  BASE_CONHECIMENTO
  PDI_SETOR
  CONTEXTO_SETOR
  FORMULARIO
  OUTRO
}

model Note {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  authorId       String?
  author         User?        @relation("NoteAuthor", fields: [authorId], references: [id])

  category NoteCategory @default(OUTRO)
  title    String
  content  String       @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, category])
}

// ─────────────────────────── CALENDÁRIO DE CALLS ───────────────────────────
// Calls do time (alinhamentos, 1:1s, treinamentos...) com a transcrição
// anexada à própria call — fonte para busca e resumo das decisões do time.
enum CallKind {
  ALINHAMENTO
  ONE_ON_ONE
  TREINAMENTO
  CLIENTE
  OUTRO
}

model Call {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String?
  createdBy      User?        @relation("CallCreatedBy", fields: [createdById], references: [id])

  title        String
  kind         CallKind @default(ALINHAMENTO)
  scheduledAt  DateTime
  durationMin  Int      @default(30)
  meetingUrl   String?
  participants String? // nomes separados por vírgula
  notes        String?  @db.Text

  transcript CallTranscript?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, scheduledAt])
}

model CallTranscript {
  id             String @id @default(cuid())
  organizationId String
  callId         String @unique
  call           Call   @relation(fields: [callId], references: [id], onDelete: Cascade)

  content String @db.Text
  source  String @default("manual") // "manual", "upload"...

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

// ─────────────────────────── TREINO DE FEEDBACK DIFÍCIL ───────────────────────────
// Simulação de conversa difícil com uma persona fictícia (nenhum dado de
// liderado real entra na simulação). Privada a quem treinou.
enum PracticeStatus {
  IN_PROGRESS
  COMPLETED
}

model FeedbackPractice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  scenarioKey String
  difficulty  Int            @default(2) // 1 receptivo · 2 defensivo · 3 hostil/emocional
  messages    Json // [{ role: "leader" | "persona", content, at }]
  status      PracticeStatus @default(IN_PROGRESS)
  score       Int? // 0–100, preenchido ao encerrar
  debrief     Json?
  engine      String         @default("rules") // "rules" | "llm"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, userId, createdAt])
}

// ─────────────────────────── BANCO DE TALENTOS ───────────────────────────
enum JobStatus {
  OPEN
  PAUSED
  CLOSED
}

model JobOpening {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String?
  createdBy      User?        @relation("OpeningCreatedBy", fields: [createdById], references: [id])

  title       String
  area        String?
  location    String?
  description String?   @db.Text
  status      JobStatus @default(OPEN)

  // Critérios do "lead scoring" da vaga — ver server/services/talent-score.ts
  requiredSkills String[]
  desiredSkills  String[]
  minYears       Int      @default(0)
  salaryMin      Int?
  salaryMax      Int?
  targetVirtues  Virtue[]

  candidates Candidate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
}

enum CandidateStatus {
  BANCO
  EM_PROCESSO
  ENTREVISTA
  PROPOSTA
  CONTRATADO
  DESCARTADO
}

model Candidate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String?
  createdBy      User?        @relation("CandidateCreatedBy", fields: [createdById], references: [id])
  // Vaga para a qual se candidatou (opcional: o candidato pode estar só no banco).
  openingId      String?
  opening        JobOpening?  @relation(fields: [openingId], references: [id], onDelete: SetNull)

  name              String
  email             String?
  phone             String?
  linkedinUrl       String?
  currentRole       String?
  location          String?
  source            String?
  yearsExperience   Int             @default(0)
  skills            String[]
  salaryExpectation Int?
  resumeText        String?         @db.Text
  notes             String?         @db.Text
  status            CandidateStatus @default(BANCO)

  // Avaliação da entrevista: nota geral 1–5 e nota por virtude { MAGNANIMIDADE: 4, ... }
  interviewRating Int?
  virtueRatings   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([openingId])
}

// ─────────────────────────── FEEDBACK ANÔNIMO AO GESTOR ───────────────────────────
// Anonimato por construção: sem autor, sem IP, sem user-agent e sem horário
// exato (só a semana). Resultados só são exibidos a partir de N respostas.
model ManagerFeedback {
  // UUID aleatório (e não cuid): o cuid embute o horário de criação, o que
  // desfaria o anonimato de "só a semana do envio".
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  managerId      String
  manager        User         @relation("ManagerFeedbackManager", fields: [managerId], references: [id], onDelete: Cascade)

  ratings   Json // { clareza: 4, apoio: 5, ... } (1–5)
  keepText  String?  @db.Text
  startText String?  @db.Text
  stopText  String?  @db.Text
  weekOf    DateTime // segunda-feira da semana do envio (00:00 UTC)

  @@index([organizationId, managerId])
}

// ─────────────────────────── CENTRAL DE DESENVOLVIMENTO ───────────────────────────
// Mural de indicações: livros, podcasts, vídeos, cursos etc.
enum ResourceType {
  LIVRO
  PODCAST
  VIDEO
  CURSO
  ARTIGO
  FERRAMENTA
  OUTRO
}

model DevResource {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String?
  createdBy      User?        @relation("ResourceCreatedBy", fields: [createdById], references: [id])

  type        ResourceType @default(LIVRO)
  title       String
  author      String?
  url         String?
  description String?      @db.Text
  focusVirtue Virtue?
  tags        String[]
  pinned      Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, type])
}

// ─────────────────────────── AUDITORIA (LGPD) ───────────────────────────
model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId        String?
  actor          User?        @relation(fields: [actorId], references: [id])

  action    String // "member.create", "feedback.view", "export.csv"...
  entity    String // "TeamMember"
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
}
